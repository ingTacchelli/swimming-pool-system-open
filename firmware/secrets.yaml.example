# Copy this file to secrets.yaml (same folder as the .yaml files) and fill it in.
# Never commit secrets.yaml to a public repository.

wifi_ssid: "NETWORK-NAME"
wifi_password: "wifi-password"

# Password of the fallback hotspot the boards create when Wi-Fi is unreachable
ap_password: "hotspot-password"

# Home Assistant API keys: generate each one with
#   python3 -c "import base64,os; print(base64.b64encode(os.urandom(32)).decode())"
api_key_control: "BASE64-KEY-CONTROL-BOARD"
api_key_display: "BASE64-KEY-DISPLAY"

# OTA password
ota_password: "ota-password"
